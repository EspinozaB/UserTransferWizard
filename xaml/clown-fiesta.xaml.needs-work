<!--
  Clown Fiesta - from clown-fiesta-bg_2.html.

  Authored at MASTER size and full strength; the surface's own quiet level is
  applied by Get-XamlMaster, so this one file serves the banner, the panels, the
  zones and the log. Coordinates are a 1200x200 canvas for the banner and are
  stretched to whatever a surface asks for.

  The clown is a resource used three times at different scales, which is the
  thing this format buys us - in GDI+ it was fifty-odd calls repeated per clown.
-->
<Canvas xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1200" Height="200">
  <Canvas.Resources>
    <!--
      One clown, in the source's own 200x320 viewBox, wrapped in a VisualBrush.

      A Canvas cannot simply be reused: a Visual has one parent, and x:Shared -
      the usual escape - is only honoured in COMPILED resource dictionaries, not
      in loose XAML loaded at runtime. A Brush has no such rule, so the clown is
      painted into one and then filled into as many rectangles as we like.
    -->
    <VisualBrush x:Key="clown" Stretch="Uniform">
     <VisualBrush.Visual>
      <Canvas Width="200" Height="320">
      <Ellipse Canvas.Left="13"  Canvas.Top="280" Width="104" Height="36" Fill="#e63946"/>
      <Ellipse Canvas.Left="83"  Canvas.Top="280" Width="104" Height="36" Fill="#2ec4b6"/>
      <Rectangle Canvas.Left="72" Canvas.Top="240" Width="22" Height="60" RadiusX="10" RadiusY="10" Fill="#fff8e7"/>
      <Rectangle Canvas.Left="106" Canvas.Top="240" Width="22" Height="60" RadiusX="10" RadiusY="10" Fill="#fff8e7"/>
      <!-- polka suit -->
      <Ellipse Canvas.Left="48" Canvas.Top="150" Width="104" Height="120" Fill="#9b59b6"/>
      <Ellipse Canvas.Left="77" Canvas.Top="177" Width="16" Height="16" Fill="#f5c842"/>
      <Ellipse Canvas.Left="107" Canvas.Top="177" Width="16" Height="16" Fill="#f5c842"/>
      <Ellipse Canvas.Left="92" Canvas.Top="202" Width="16" Height="16" Fill="#f5c842"/>
      <Ellipse Canvas.Left="71" Canvas.Top="223" Width="14" Height="14" Fill="#f5c842"/>
      <Ellipse Canvas.Left="115" Canvas.Top="223" Width="14" Height="14" Fill="#f5c842"/>
      <!-- collar ruffles -->
      <Ellipse Canvas.Left="52" Canvas.Top="138" Width="96" Height="40" Fill="#ff6eb4"/>
      <Ellipse Canvas.Left="53" Canvas.Top="138" Width="44" Height="28" Fill="#e63946"/>
      <Ellipse Canvas.Left="103" Canvas.Top="138" Width="44" Height="28" Fill="#2ec4b6"/>
      <Ellipse Canvas.Left="80" Canvas.Top="136" Width="40" Height="24" Fill="#f5c842"/>
      <Rectangle Canvas.Left="88" Canvas.Top="138" Width="24" Height="20" RadiusX="8" RadiusY="8" Fill="#ffe0c0"/>
      <!-- hair, both sides -->
      <Ellipse Canvas.Left="2"   Canvas.Top="57" Width="56" Height="56" Fill="#f5a623"/>
      <Ellipse Canvas.Left="0"   Canvas.Top="50" Width="40" Height="40" Fill="#f5a623"/>
      <Ellipse Canvas.Left="20"  Canvas.Top="44" Width="36" Height="36" Fill="#f5a623"/>
      <Ellipse Canvas.Left="142" Canvas.Top="57" Width="56" Height="56" Fill="#f5a623"/>
      <Ellipse Canvas.Left="160" Canvas.Top="50" Width="40" Height="40" Fill="#f5a623"/>
      <Ellipse Canvas.Left="144" Canvas.Top="44" Width="36" Height="36" Fill="#f5a623"/>
      <!-- head -->
      <Ellipse Canvas.Left="45" Canvas.Top="48" Width="110" Height="120" Fill="#ffe0c0"/>
      <!-- top hat -->
      <Rectangle Canvas.Left="62" Canvas.Top="32" Width="76" Height="55" RadiusX="6" RadiusY="6" Fill="#1a0a2e"/>
      <Rectangle Canvas.Left="50" Canvas.Top="82" Width="100" Height="14" RadiusX="4" RadiusY="4" Fill="#2d1060"/>
      <Rectangle Canvas.Left="68" Canvas.Top="36" Width="64" Height="6" RadiusX="2" RadiusY="2" Fill="#f5c842"/>
      <Ellipse Canvas.Left="110" Canvas.Top="40" Width="20" Height="20" Fill="#ff6eb4"/>
      <Ellipse Canvas.Left="102" Canvas.Top="37" Width="16" Height="16" Fill="#e63946"/>
      <Ellipse Canvas.Left="122" Canvas.Top="37" Width="16" Height="16" Fill="#2ec4b6"/>
      <Ellipse Canvas.Left="113" Canvas.Top="31" Width="14" Height="14" Fill="#f5c842"/>
      <!-- eyes, brows, nose, smile -->
      <Ellipse Canvas.Left="66" Canvas.Top="94" Width="28" Height="32" Fill="#ffffff"/>
      <Ellipse Canvas.Left="106" Canvas.Top="94" Width="28" Height="32" Fill="#ffffff"/>
      <Ellipse Canvas.Left="74" Canvas.Top="105" Width="16" Height="16" Fill="#2d1060"/>
      <Ellipse Canvas.Left="114" Canvas.Top="105" Width="16" Height="16" Fill="#2d1060"/>
      <Path Stroke="#8B4513" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
            Data="M68,97 Q80,88 92,97"/>
      <Path Stroke="#8B4513" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
            Data="M108,97 Q120,88 132,97"/>
      <Ellipse Canvas.Left="84" Canvas.Top="115" Width="32" Height="26" Fill="#e63946"/>
      <Path Fill="#ffe0c0" Stroke="#c0392b" StrokeThickness="4" StrokeStartLineCap="Round"
            Data="M70,145 Q100,172 130,145"/>
      <Ellipse Canvas.Left="54" Canvas.Top="125" Width="28" Height="20" Fill="#ff9999" Opacity="0.5"/>
      <Ellipse Canvas.Left="118" Canvas.Top="125" Width="28" Height="20" Fill="#ff9999" Opacity="0.5"/>
      <!-- arms and gloves -->
      <Path Stroke="#ffe0c0" StrokeThickness="18" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
            Data="M50,175 Q20,155 10,130"/>
      <Path Stroke="#ffe0c0" StrokeThickness="18" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
            Data="M150,175 Q180,155 190,130"/>
      <Ellipse Canvas.Left="-8" Canvas.Top="107" Width="36" Height="36" Fill="#ffffff"/>
      <Ellipse Canvas.Left="172" Canvas.Top="107" Width="36" Height="36" Fill="#ffffff"/>
      <!-- the balloon on its string -->
      <Line X1="190" Y1="108" X2="195" Y2="60" Stroke="#888888" StrokeThickness="2"/>
      <Ellipse Canvas.Left="182" Canvas.Top="30" Width="28" Height="36" Fill="#e63946"/>
      </Canvas>
     </VisualBrush.Visual>
    </VisualBrush>
  </Canvas.Resources>

  <!-- ground: the radial party light -->
  <Rectangle Width="1200" Height="200">
    <Rectangle.Fill>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2d1060" Offset="0"/>
        <GradientStop Color="#1a0a2e" Offset="1"/>
      </LinearGradientBrush>
    </Rectangle.Fill>
  </Rectangle>
  <Ellipse Canvas.Left="120" Canvas.Top="-190" Width="960" Height="580" Opacity="0.34">
    <Ellipse.Fill>
      <RadialGradientBrush>
        <GradientStop Color="#9b59b6" Offset="0"/>
        <GradientStop Color="#009b59b6" Offset="1"/>
      </RadialGradientBrush>
    </Ellipse.Fill>
  </Ellipse>
  <Ellipse Canvas.Left="-180" Canvas.Top="60" Width="620" Height="360" Opacity="0.22">
    <Ellipse.Fill>
      <RadialGradientBrush>
        <GradientStop Color="#ff6eb4" Offset="0"/>
        <GradientStop Color="#00ff6eb4" Offset="1"/>
      </RadialGradientBrush>
    </Ellipse.Fill>
  </Ellipse>
  <Ellipse Canvas.Left="880" Canvas.Top="-150" Width="560" Height="330" Opacity="0.22">
    <Ellipse.Fill>
      <RadialGradientBrush>
        <GradientStop Color="#2ec4b6" Offset="0"/>
        <GradientStop Color="#002ec4b6" Offset="1"/>
      </RadialGradientBrush>
    </Ellipse.Fill>
  </Ellipse>

  <!--
    Bunting, strung across the MIDDLE only.

    Run edge to edge it was the brightest thing in both caption bands - a white
    string at half opacity plus saturated flags - and it held the banner's worst
    contrast at 1.48:1 no matter what the glows underneath it did. Hung between
    the clowns it is more of a party and none of a problem.
  -->
  <Path Stroke="#ffffff" StrokeThickness="1.6" Opacity="0.5"
        Data="M448,18 Q600,52 792,18"/>
  <Canvas Opacity="0.85">
    <Polygon Points="466,24 490,24 478,46" Fill="#e63946"/>
    <Polygon Points="484,34 508,34 496,56" Fill="#f5c842"/>
    <Polygon Points="544,42 568,42 556,64" Fill="#2ec4b6"/>
    <Polygon Points="604,44 628,44 616,66" Fill="#ff6eb4"/>
    <Polygon Points="664,42 688,42 676,64" Fill="#9b59b6"/>
    <Polygon Points="724,34 748,34 736,56" Fill="#e63946"/>
    <Polygon Points="784,22 808,22 796,44" Fill="#f5c842"/>
  </Canvas>

  <!--
    Balloons and confetti keep to the MIDDLE.

    The banner's captions are anchored at its two ends - title and subtitle on
    the left, mode and administrator warning on the right - and the middle
    carries no text, which is why the clowns stand there. Bright party colours
    in the end bands drop the caption contrast to 1.48:1; the same shapes a few
    hundred pixels inwards cost nothing and are more visible anyway, being next
    to the clowns rather than behind a word.
  -->
  <Ellipse Canvas.Left="452" Canvas.Top="30" Width="34" Height="44" Fill="#f5c842" Opacity="0.75"/>
  <Ellipse Canvas.Left="778" Canvas.Top="26" Width="34" Height="44" Fill="#2ec4b6" Opacity="0.75"/>

  <!-- THE CLOWNS, in the clear middle of the banner -->
  <Rectangle Canvas.Left="560" Canvas.Top="8"  Width="120" Height="192" Fill="{StaticResource clown}"/>
  <Rectangle Canvas.Left="438" Canvas.Top="53" Width="92"  Height="147" Fill="{StaticResource clown}"/>
  <Rectangle Canvas.Left="694" Canvas.Top="59" Width="88"  Height="141" Fill="{StaticResource clown}"/>

  <!-- confetti -->
  <Canvas Opacity="0.8">
    <Rectangle Canvas.Left="462" Canvas.Top="120" Width="8" Height="13" Fill="#f5c842" RadiusX="2" RadiusY="2"/>
    <Rectangle Canvas.Left="500" Canvas.Top="72"  Width="8" Height="13" Fill="#2ec4b6" RadiusX="2" RadiusY="2"/>
    <Rectangle Canvas.Left="596" Canvas.Top="26"  Width="8" Height="13" Fill="#ff6eb4" RadiusX="2" RadiusY="2"/>
    <Rectangle Canvas.Left="688" Canvas.Top="42"  Width="8" Height="13" Fill="#e63946" RadiusX="2" RadiusY="2"/>
    <Rectangle Canvas.Left="748" Canvas.Top="150" Width="8" Height="13" Fill="#f5c842" RadiusX="2" RadiusY="2"/>
    <Rectangle Canvas.Left="800" Canvas.Top="90"  Width="8" Height="13" Fill="#2ec4b6" RadiusX="2" RadiusY="2"/>
    <Ellipse Canvas.Left="470" Canvas.Top="168" Width="9" Height="9" Fill="#ff6eb4"/>
    <Ellipse Canvas.Left="540" Canvas.Top="96"  Width="9" Height="9" Fill="#f5c842"/>
    <Ellipse Canvas.Left="656" Canvas.Top="176" Width="9" Height="9" Fill="#9b59b6"/>
    <Ellipse Canvas.Left="726" Canvas.Top="128" Width="9" Height="9" Fill="#e63946"/>
  </Canvas>
</Canvas>
