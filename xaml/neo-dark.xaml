<!--
  Neo Dark, banner surface - the same picture as the GDI+ painter in
  UTW-Themes.ps1, written as XAML instead.

  This exists to be COMPARED against that painter. It is rendered once to a
  bitmap at master size and then fed through exactly the same scale-and-cache
  path as everything else, so the only thing that changes is how the artwork is
  authored. Coordinates are master pixels (1200 x 200).
-->
<Canvas xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1200" Height="200">

  <!-- base wash: linear-gradient(160deg, bg-1 0%, bg-0 70%) -->
  <Rectangle Width="1200" Height="200">
    <Rectangle.Fill>
      <LinearGradientBrush StartPoint="0,0" EndPoint="0.6,1">
        <GradientStop Color="#082334" Offset="0"/>
        <GradientStop Color="#04121c" Offset="0.7"/>
      </LinearGradientBrush>
    </Rectangle.Fill>
  </Rectangle>

  <!-- radial(120% 90% at 18% 12%, bg-2) -->
  <Ellipse Canvas.Left="-260" Canvas.Top="-190" Width="1040" Height="620" Opacity="0.75">
    <Ellipse.Fill>
      <RadialGradientBrush>
        <GradientStop Color="#06323d" Offset="0"/>
        <GradientStop Color="#0006323d" Offset="1"/>
      </RadialGradientBrush>
    </Ellipse.Fill>
  </Ellipse>

  <!-- the three aurora ribbons: blurred, screen-blended, drifting -->
  <Ellipse Canvas.Left="-240" Canvas.Top="-230" Width="900" Height="560" Opacity="0.55">
    <Ellipse.Fill>
      <RadialGradientBrush>
        <GradientStop Color="#35c3f3" Offset="0"/>
        <GradientStop Color="#0035c3f3" Offset="0.68"/>
      </RadialGradientBrush>
    </Ellipse.Fill>
  </Ellipse>

  <Ellipse Canvas.Left="760" Canvas.Top="-90" Width="760" Height="470" Opacity="0.5">
    <Ellipse.Fill>
      <RadialGradientBrush>
        <GradientStop Color="#4de2b0" Offset="0"/>
        <GradientStop Color="#004de2b0" Offset="0.68"/>
      </RadialGradientBrush>
    </Ellipse.Fill>
  </Ellipse>

  <Ellipse Canvas.Left="240" Canvas.Top="90" Width="980" Height="380" Opacity="0.32">
    <Ellipse.Fill>
      <RadialGradientBrush>
        <GradientStop Color="#8ad6ff" Offset="0"/>
        <GradientStop Color="#008ad6ff" Offset="0.7"/>
      </RadialGradientBrush>
    </Ellipse.Fill>
  </Ellipse>

  <!-- light shafts: the <polygon> rays, white fading down -->
  <Canvas Opacity="0.28">
    <Polygon Points="120,-40 260,-40 640,240 420,240">
      <Polygon.Fill>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0.3,1">
          <GradientStop Color="#8CFFFFFF" Offset="0"/>
          <GradientStop Color="#00FFFFFF" Offset="1"/>
        </LinearGradientBrush>
      </Polygon.Fill>
    </Polygon>
    <Polygon Points="300,-40 370,-40 760,240 640,240">
      <Polygon.Fill>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0.3,1">
          <GradientStop Color="#8CFFFFFF" Offset="0"/>
          <GradientStop Color="#00FFFFFF" Offset="1"/>
        </LinearGradientBrush>
      </Polygon.Fill>
    </Polygon>
    <Polygon Points="470,-40 505,-40 880,240 815,240">
      <Polygon.Fill>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0.3,1">
          <GradientStop Color="#8CFFFFFF" Offset="0"/>
          <GradientStop Color="#00FFFFFF" Offset="1"/>
        </LinearGradientBrush>
      </Polygon.Fill>
    </Polygon>
  </Canvas>

  <!-- the Aero glass panes: gloss over the top half, 1px light border -->
  <Border Canvas.Left="96"  Canvas.Top="32" Width="360" Height="88" CornerRadius="18"
          BorderThickness="1" BorderBrush="#2EFFFFFF">
    <Border.RenderTransform><RotateTransform Angle="-6" CenterX="180" CenterY="44"/></Border.RenderTransform>
    <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="0.6,1">
        <GradientStop Color="#24FFFFFF" Offset="0"/>
        <GradientStop Color="#0DFFFFFF" Offset="0.42"/>
        <GradientStop Color="#05FFFFFF" Offset="1"/>
      </LinearGradientBrush>
    </Border.Background>
    <Rectangle Height="42" VerticalAlignment="Top">
      <Rectangle.Fill>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#38FFFFFF" Offset="0"/>
          <GradientStop Color="#00FFFFFF" Offset="1"/>
        </LinearGradientBrush>
      </Rectangle.Fill>
    </Rectangle>
  </Border>

  <Border Canvas.Left="792" Canvas.Top="20" Width="288" Height="60" CornerRadius="18"
          BorderThickness="1" BorderBrush="#2EFFFFFF">
    <Border.RenderTransform><RotateTransform Angle="5" CenterX="144" CenterY="30"/></Border.RenderTransform>
    <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="0.6,1">
        <GradientStop Color="#24FFFFFF" Offset="0"/>
        <GradientStop Color="#05FFFFFF" Offset="1"/>
      </LinearGradientBrush>
    </Border.Background>
  </Border>

  <Border Canvas.Left="744" Canvas.Top="116" Width="360" Height="56" CornerRadius="18"
          BorderThickness="1" BorderBrush="#2EFFFFFF">
    <Border.RenderTransform><RotateTransform Angle="-3" CenterX="180" CenterY="28"/></Border.RenderTransform>
    <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="0.6,1">
        <GradientStop Color="#24FFFFFF" Offset="0"/>
        <GradientStop Color="#05FFFFFF" Offset="1"/>
      </LinearGradientBrush>
    </Border.Background>
  </Border>

  <Border Canvas.Left="480" Canvas.Top="124" Width="216" Height="68" CornerRadius="18"
          BorderThickness="1" BorderBrush="#2EFFFFFF">
    <Border.RenderTransform><RotateTransform Angle="8" CenterX="108" CenterY="34"/></Border.RenderTransform>
    <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="0.6,1">
        <GradientStop Color="#24FFFFFF" Offset="0"/>
        <GradientStop Color="#05FFFFFF" Offset="1"/>
      </LinearGradientBrush>
    </Border.Background>
  </Border>
</Canvas>
