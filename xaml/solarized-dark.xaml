<!-- Solarized Dark - from solarized-dark-bg.html: a sun below the horizon, a
     wheel of coloured rays turning out of the bottom edge, a breathing corona,
     horizon haze and a terminal cell grid over everything. -->
<Canvas xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1200" Height="200">
  <Rectangle Width="1200" Height="200">
    <Rectangle.Fill>
      <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00202a" Offset="0"/>
        <GradientStop Color="#002b36" Offset="0.55"/>
        <GradientStop Color="#00323e" Offset="1"/>
      </LinearGradientBrush>
    </Rectangle.Fill>
  </Rectangle>

  <!-- base02 glow, top left -->
  <Ellipse Canvas.Left="-160" Canvas.Top="-180" Width="900" Height="500" Opacity="0.6">
    <Ellipse.Fill>
      <RadialGradientBrush>
        <GradientStop Color="#073642" Offset="0"/>
        <GradientStop Color="#00073642" Offset="1"/>
      </RadialGradientBrush>
    </Ellipse.Fill>
  </Ellipse>

  <!-- the ray wheel, radiating from just below bottom centre -->
  <Canvas Opacity="0.38">
    <Polygon Points="600,210 250,-120 330,-140"  Fill="#b58900"/>
    <Polygon Points="600,210 380,-160 450,-170"  Fill="#cb4b16"/>
    <Polygon Points="600,210 520,-180 570,-182"  Fill="#dc322f"/>
    <Polygon Points="600,210 640,-182 690,-176"  Fill="#d33682"/>
    <Polygon Points="600,210 770,-166 830,-150"  Fill="#6c71c4"/>
    <Polygon Points="600,210 900,-130 960,-104"  Fill="#268bd2"/>
    <Polygon Points="600,210 1030,-70 1090,-32"  Fill="#2aa198"/>
    <Polygon Points="600,210 170,-60  120,-20"   Fill="#859900"/>
  </Canvas>

  <!-- the corona sitting just under the horizon -->
  <Ellipse Canvas.Left="60" Canvas.Top="96" Width="1080" Height="280" Opacity="0.5">
    <Ellipse.Fill>
      <RadialGradientBrush GradientOrigin="0.5,1" Center="0.5,1" RadiusX="0.5" RadiusY="1">
        <GradientStop Color="#fdf6e3" Offset="0"/>
        <GradientStop Color="#b58900" Offset="0.28"/>
        <GradientStop Color="#2aa198" Offset="0.52"/>
        <GradientStop Color="#002aa198" Offset="0.78"/>
      </RadialGradientBrush>
    </Ellipse.Fill>
  </Ellipse>

  <!-- horizon haze -->
  <Rectangle Canvas.Top="120" Width="1200" Height="80" Opacity="0.55">
    <Rectangle.Fill>
      <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
        <GradientStop Color="#0a4b59" Offset="0"/>
        <GradientStop Color="#000a4b59" Offset="1"/>
      </LinearGradientBrush>
    </Rectangle.Fill>
  </Rectangle>

  <!-- the terminal cell grid: 1px every 9 across, every 18 down -->
  <Rectangle Width="1200" Height="200" Opacity="0.5">
    <Rectangle.Fill>
      <DrawingBrush TileMode="Tile" Viewport="0,0,9,18" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
          <GeometryDrawing Brush="#0E586E75">
            <GeometryDrawing.Geometry>
              <GeometryGroup>
                <RectangleGeometry Rect="0,0,1,18"/>
                <RectangleGeometry Rect="0,0,9,1"/>
              </GeometryGroup>
            </GeometryDrawing.Geometry>
          </GeometryDrawing>
        </DrawingBrush.Drawing>
      </DrawingBrush>
    </Rectangle.Fill>
  </Rectangle>
</Canvas>
