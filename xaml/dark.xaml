<!-- Dark (Metro) - from metro-dark-bg.html: a flat ground and six long
     diagonals on a slow 'crawl', with two accent glows. -->
<Canvas xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1200" Height="200">
  <Rectangle Width="1200" Height="200">
    <Rectangle.Fill>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.6">
        <GradientStop Color="#2e2e2e" Offset="0"/>
        <GradientStop Color="#1c1c1c" Offset="1"/>
      </LinearGradientBrush>
    </Rectangle.Fill>
  </Rectangle>

  <Ellipse Canvas.Left="-120" Canvas.Top="-180" Width="760" Height="460" Opacity="0.30">
    <Ellipse.Fill>
      <RadialGradientBrush>
        <GradientStop Color="#ff7a18" Offset="0"/>
        <GradientStop Color="#00ff7a18" Offset="1"/>
      </RadialGradientBrush>
    </Ellipse.Fill>
  </Ellipse>
  <Ellipse Canvas.Left="740" Canvas.Top="20" Width="660" Height="380" Opacity="0.24">
    <Ellipse.Fill>
      <RadialGradientBrush>
        <GradientStop Color="#a97bec" Offset="0"/>
        <GradientStop Color="#00a97bec" Offset="1"/>
      </RadialGradientBrush>
    </Ellipse.Fill>
  </Ellipse>

  <!-- the six crawling diagonals -->
  <Canvas>
    <Line X1="-120" Y1="86"  X2="1200" Y2="-14" Stroke="#ff7a18" StrokeThickness="3" Opacity="0.20"/>
    <Line X1="-120" Y1="118" X2="1200" Y2="18"  Stroke="#a97bec" StrokeThickness="3" Opacity="0.17"/>
    <Line X1="-120" Y1="150" X2="1200" Y2="50"  Stroke="#ff7a18" StrokeThickness="3" Opacity="0.15"/>
    <Line X1="-120" Y1="182" X2="1200" Y2="82"  Stroke="#a97bec" StrokeThickness="3" Opacity="0.13"/>
    <Line X1="-120" Y1="214" X2="1200" Y2="114" Stroke="#ff7a18" StrokeThickness="3" Opacity="0.11"/>
    <Line X1="-120" Y1="246" X2="1200" Y2="146" Stroke="#a97bec" StrokeThickness="3" Opacity="0.09"/>
  </Canvas>
</Canvas>
