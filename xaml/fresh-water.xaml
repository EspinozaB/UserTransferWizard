<!-- Fresh Water - from freshwater-bg.html: lit water, sliding swooshes, a
     shimmer band along the surface, and bubbles. -->
<Canvas xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1200" Height="200">
  <Rectangle Width="1200" Height="200">
    <Rectangle.Fill>
      <LinearGradientBrush StartPoint="0,0" EndPoint="0.6,1">
        <GradientStop Color="#1583c4" Offset="0"/>
        <GradientStop Color="#073b52" Offset="1"/>
      </LinearGradientBrush>
    </Rectangle.Fill>
  </Rectangle>

  <!-- light coming through the surface -->
  <Ellipse Canvas.Left="-120" Canvas.Top="-260" Width="1040" Height="600" Opacity="0.55">
    <Ellipse.Fill>
      <RadialGradientBrush>
        <GradientStop Color="#8fe2f6" Offset="0"/>
        <GradientStop Color="#008fe2f6" Offset="1"/>
      </RadialGradientBrush>
    </Ellipse.Fill>
  </Ellipse>
  <Ellipse Canvas.Left="760" Canvas.Top="-90" Width="640" Height="380" Opacity="0.4">
    <Ellipse.Fill>
      <RadialGradientBrush>
        <GradientStop Color="#24c9e8" Offset="0"/>
        <GradientStop Color="#0024c9e8" Offset="1"/>
      </RadialGradientBrush>
    </Ellipse.Fill>
  </Ellipse>

  <!-- the three sliding swooshes -->
  <Path Fill="#6ff0c8" Opacity="0.28" Data="M-60,66 Q540,10 1260,66 Q600,96 -60,66 Z"/>
  <Path Fill="#6ff0c8" Opacity="0.20" Data="M-60,118 Q660,66 1260,118 Q600,144 -60,118 Z"/>
  <Path Fill="#6ff0c8" Opacity="0.14" Data="M-60,164 Q480,122 1260,164 Q660,186 -60,164 Z"/>

  <!-- shimmerLine along the surface -->
  <Path Stroke="#dff6ff" StrokeThickness="2.4" Opacity="0.5" Data="M0,32 L1200,22"/>

  <!-- bubbles -->
  <Canvas Opacity="0.5">
    <Ellipse Canvas.Left="90"   Canvas.Top="150" Width="14" Height="14" Stroke="#dff6ff" StrokeThickness="1.4"/>
    <Ellipse Canvas.Left="250"  Canvas.Top="108" Width="9"  Height="9"  Stroke="#dff6ff" StrokeThickness="1.4"/>
    <Ellipse Canvas.Left="410"  Canvas.Top="168" Width="18" Height="18" Stroke="#dff6ff" StrokeThickness="1.4"/>
    <Ellipse Canvas.Left="560"  Canvas.Top="88"  Width="11" Height="11" Stroke="#b9ecfb" StrokeThickness="1.4"/>
    <Ellipse Canvas.Left="720"  Canvas.Top="140" Width="15" Height="15" Stroke="#dff6ff" StrokeThickness="1.4"/>
    <Ellipse Canvas.Left="880"  Canvas.Top="96"  Width="8"  Height="8"  Stroke="#dff6ff" StrokeThickness="1.4"/>
    <Ellipse Canvas.Left="1020" Canvas.Top="158" Width="16" Height="16" Stroke="#b9ecfb" StrokeThickness="1.4"/>
    <Ellipse Canvas.Left="1140" Canvas.Top="118" Width="10" Height="10" Stroke="#dff6ff" StrokeThickness="1.4"/>
  </Canvas>
</Canvas>
