<!-- Run button glyph. Drawn inside a margin (roughly 4..20 of a 24x24 box) so
     it never touches its own edge - a glyph that does reads as cut off once it
     is sitting next to the button's caption. White: the button is filled with
     the operation's accent colour and white reads on all of them. -->
<Canvas xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="24" Height="24">  <Rectangle Canvas.Left="4"  Canvas.Top="7" Width="5" Height="10" RadiusX="1" RadiusY="1" Stroke="#ffffff" StrokeThickness="1.8" Fill="#00000000"/>
  <Rectangle Canvas.Left="15" Canvas.Top="7" Width="5" Height="10" RadiusX="1" RadiusY="1" Stroke="#ffffff" StrokeThickness="1.8" Fill="#00000000"/>
  <Path Stroke="#ffffff" StrokeThickness="1.8" StrokeStartLineCap="Round" Data="M9.5,12 L13,12"/>
  <Path Fill="#ffffff" Data="M15,12 L11.5,9.6 L11.5,14.4 Z"/>
</Canvas>
