<!-- Waste Water - from wastewater-bg.html: settled bands, slow morphing blobs
     ('morph'/'wander'), drifting scum and a lot of aeration. -->
<Canvas xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1200" Height="200">
  <Rectangle Width="1200" Height="200">
    <Rectangle.Fill>
      <LinearGradientBrush StartPoint="0,0" EndPoint="0.5,1">
        <GradientStop Color="#2b3a1c" Offset="0"/>
        <GradientStop Color="#0c1109" Offset="1"/>
      </LinearGradientBrush>
    </Rectangle.Fill>
  </Rectangle>

  <!-- the settled bands -->
  <Rectangle Canvas.Top="44"  Width="1200" Height="32" Fill="#48562f" Opacity="0.35"/>
  <Rectangle Canvas.Top="104" Width="1200" Height="40" Fill="#2f3a25" Opacity="0.32"/>
  <Rectangle Canvas.Top="160" Width="1200" Height="40" Fill="#1a2115" Opacity="0.28"/>

  <!-- morphing blobs -->
  <Ellipse Canvas.Left="60" Canvas.Top="-60" Width="600" Height="320" Opacity="0.45">
    <Ellipse.Fill>
      <RadialGradientBrush>
        <GradientStop Color="#54692c" Offset="0"/>
        <GradientStop Color="#0054692c" Offset="1"/>
      </RadialGradientBrush>
    </Ellipse.Fill>
  </Ellipse>
  <Ellipse Canvas.Left="700" Canvas.Top="40" Width="560" Height="300" Opacity="0.34">
    <Ellipse.Fill>
      <RadialGradientBrush>
        <GradientStop Color="#93a352" Offset="0"/>
        <GradientStop Color="#0093a352" Offset="1"/>
      </RadialGradientBrush>
    </Ellipse.Fill>
  </Ellipse>

  <!-- drifting scum -->
  <Canvas Opacity="0.4">
    <Ellipse Canvas.Left="140" Canvas.Top="24"  Width="86" Height="26" Fill="#5d6b33"/>
    <Ellipse Canvas.Left="420" Canvas.Top="12"  Width="120" Height="30" Fill="#2c4a19"/>
    <Ellipse Canvas.Left="760" Canvas.Top="28"  Width="96" Height="24" Fill="#5d6b33"/>
    <Ellipse Canvas.Left="1000" Canvas.Top="16" Width="130" Height="28" Fill="#2c4a19"/>
  </Canvas>

  <!-- aeration: bubbles, three sizes, plenty of them -->
  <Canvas Opacity="0.55">
    <Ellipse Canvas.Left="70"   Canvas.Top="150" Width="16" Height="16" Stroke="#93a352" StrokeThickness="1.4"/>
    <Ellipse Canvas.Left="130"  Canvas.Top="112" Width="9"  Height="9"  Stroke="#c9d98a" StrokeThickness="1.4"/>
    <Ellipse Canvas.Left="210"  Canvas.Top="172" Width="12" Height="12" Stroke="#93a352" StrokeThickness="1.4"/>
    <Ellipse Canvas.Left="300"  Canvas.Top="94"  Width="18" Height="18" Stroke="#c9d98a" StrokeThickness="1.4"/>
    <Ellipse Canvas.Left="380"  Canvas.Top="140" Width="8"  Height="8"  Stroke="#93a352" StrokeThickness="1.4"/>
    <Ellipse Canvas.Left="470"  Canvas.Top="178" Width="14" Height="14" Stroke="#c9d98a" StrokeThickness="1.4"/>
    <Ellipse Canvas.Left="560"  Canvas.Top="120" Width="11" Height="11" Stroke="#93a352" StrokeThickness="1.4"/>
    <Ellipse Canvas.Left="650"  Canvas.Top="158" Width="17" Height="17" Stroke="#c9d98a" StrokeThickness="1.4"/>
    <Ellipse Canvas.Left="740"  Canvas.Top="102" Width="10" Height="10" Stroke="#93a352" StrokeThickness="1.4"/>
    <Ellipse Canvas.Left="830"  Canvas.Top="168" Width="13" Height="13" Stroke="#c9d98a" StrokeThickness="1.4"/>
    <Ellipse Canvas.Left="920"  Canvas.Top="130" Width="15" Height="15" Stroke="#93a352" StrokeThickness="1.4"/>
    <Ellipse Canvas.Left="1010" Canvas.Top="96"  Width="9"  Height="9"  Stroke="#c9d98a" StrokeThickness="1.4"/>
    <Ellipse Canvas.Left="1090" Canvas.Top="164" Width="16" Height="16" Stroke="#93a352" StrokeThickness="1.4"/>
    <Ellipse Canvas.Left="1150" Canvas.Top="124" Width="11" Height="11" Stroke="#c9d98a" StrokeThickness="1.4"/>
  </Canvas>
</Canvas>
