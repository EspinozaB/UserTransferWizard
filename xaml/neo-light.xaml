<!-- Neo Light - from neo-light-bg.html. Same Aero composition as the dark
     twin, tuned on its own numbers: over white the washes need roughly double
     the strength to read at all, and the glass panes need a visible border
     rather than a pale one. -->
<Canvas xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1200" Height="200">
  <Rectangle Width="1200" Height="200">
    <Rectangle.Fill>
      <LinearGradientBrush StartPoint="0,0" EndPoint="0.6,1">
        <GradientStop Color="#ffffff" Offset="0"/>
        <GradientStop Color="#dcf1f8" Offset="1"/>
      </LinearGradientBrush>
    </Rectangle.Fill>
  </Rectangle>

  <!-- the three aurora ribbons -->
  <Ellipse Canvas.Left="-240" Canvas.Top="-230" Width="900" Height="560" Opacity="0.60">
    <Ellipse.Fill>
      <RadialGradientBrush>
        <GradientStop Color="#0f9bd7" Offset="0"/>
        <GradientStop Color="#000f9bd7" Offset="0.68"/>
      </RadialGradientBrush>
    </Ellipse.Fill>
  </Ellipse>
  <Ellipse Canvas.Left="760" Canvas.Top="-90" Width="760" Height="470" Opacity="0.52">
    <Ellipse.Fill>
      <RadialGradientBrush>
        <GradientStop Color="#21b58e" Offset="0"/>
        <GradientStop Color="#0021b58e" Offset="0.68"/>
      </RadialGradientBrush>
    </Ellipse.Fill>
  </Ellipse>
  <Ellipse Canvas.Left="240" Canvas.Top="90" Width="980" Height="380" Opacity="0.40">
    <Ellipse.Fill>
      <RadialGradientBrush>
        <GradientStop Color="#7fd8f7" Offset="0"/>
        <GradientStop Color="#007fd8f7" Offset="0.7"/>
      </RadialGradientBrush>
    </Ellipse.Fill>
  </Ellipse>

  <!-- light shafts -->
  <Canvas Opacity="0.30">
    <Polygon Points="120,-40 260,-40 640,240 420,240">
      <Polygon.Fill>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0.3,1">
          <GradientStop Color="#A6FFFFFF" Offset="0"/>
          <GradientStop Color="#00FFFFFF" Offset="1"/>
        </LinearGradientBrush>
      </Polygon.Fill>
    </Polygon>
    <Polygon Points="470,-40 505,-40 880,240 815,240">
      <Polygon.Fill>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0.3,1">
          <GradientStop Color="#A6FFFFFF" Offset="0"/>
          <GradientStop Color="#00FFFFFF" Offset="1"/>
        </LinearGradientBrush>
      </Polygon.Fill>
    </Polygon>
  </Canvas>

  <!-- glass panes -->
  <Border Canvas.Left="96"  Canvas.Top="32" Width="360" Height="88" CornerRadius="18"
          BorderThickness="1" BorderBrush="#5910333F">
    <Border.RenderTransform><RotateTransform Angle="-6" CenterX="180" CenterY="44"/></Border.RenderTransform>
    <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="0.6,1">
        <GradientStop Color="#66FFFFFF" Offset="0"/>
        <GradientStop Color="#1AFFFFFF" Offset="1"/>
      </LinearGradientBrush>
    </Border.Background>
  </Border>
  <Border Canvas.Left="792" Canvas.Top="20" Width="288" Height="60" CornerRadius="18"
          BorderThickness="1" BorderBrush="#5910333F">
    <Border.RenderTransform><RotateTransform Angle="5" CenterX="144" CenterY="30"/></Border.RenderTransform>
    <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="0.6,1">
        <GradientStop Color="#66FFFFFF" Offset="0"/>
        <GradientStop Color="#1AFFFFFF" Offset="1"/>
      </LinearGradientBrush>
    </Border.Background>
  </Border>
  <Border Canvas.Left="744" Canvas.Top="116" Width="360" Height="56" CornerRadius="18"
          BorderThickness="1" BorderBrush="#5910333F">
    <Border.RenderTransform><RotateTransform Angle="-3" CenterX="180" CenterY="28"/></Border.RenderTransform>
    <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="0.6,1">
        <GradientStop Color="#66FFFFFF" Offset="0"/>
        <GradientStop Color="#1AFFFFFF" Offset="1"/>
      </LinearGradientBrush>
    </Border.Background>
  </Border>
  <Border Canvas.Left="480" Canvas.Top="124" Width="216" Height="68" CornerRadius="18"
          BorderThickness="1" BorderBrush="#5910333F">
    <Border.RenderTransform><RotateTransform Angle="8" CenterX="108" CenterY="34"/></Border.RenderTransform>
    <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="0.6,1">
        <GradientStop Color="#66FFFFFF" Offset="0"/>
        <GradientStop Color="#1AFFFFFF" Offset="1"/>
      </LinearGradientBrush>
    </Border.Background>
  </Border>
</Canvas>
